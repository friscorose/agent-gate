#!/usr/bin/env bash
# agent-gate — review-gated AI agent commits on GitHub Free.
# Commands: setup | repo | check | review | land.   See docs/GUIDE.md.
# SPDX-License-Identifier: MIT
set -euo pipefail

VERSION=0.1.0
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agent-gate"
CONF="$CONF_DIR/config"

die()  { printf 'agent-gate: %s\n' "$*" >&2; exit 1; }
say()  { printf '  %s\n' "$*"; }
ok()   { printf '  ok    %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*"; FAILS=$((FAILS+1)); }
need() { for c in "$@"; do command -v "$c" >/dev/null || die "missing required command: $c"; done; }
ask()  { local a; read -r -p "  $1 [y/N] " a; [[ $a == [yY]* ]]; }

usage() {
  cat <<EOF
agent-gate $VERSION — agents push branches to a bot repo; only you merge into yours.

  agent-gate setup --owner USER --bot BOTUSER [--alias HOST] [--key PATH]
        One time. SSH key and host alias for the bot, separate gh login for the bot,
        saves config to $CONF.
  agent-gate repo [--public] [NAME]
        In a git repo with a 'main' branch. Private (default): create <owner>/NAME and
        <bot>/NAME, both private, the bot's not a fork. --public: create <owner>/NAME
        public and fork it as the bot (pull-request route). Adds remotes 'origin' and
        'bot', pushes main.
  agent-gate check
        Verify identities, the SSH alias and, inside a repo, remotes and gate invariants.
  agent-gate review BRANCH [-p | --by-commit] [-- PATH...]
        Fetch the bot repo and show what BRANCH would bring into main: commits and
        diffstat; -p adds the full diff, --by-commit shows each commit with its diff.
        PATHs limit the output to those files or directories.
  agent-gate land BRANCH [-m MSG] [--keep]
        Merge bot/BRANCH into main (--no-ff), run AG_TEST_CMD if configured,
        push main to origin and bot, delete the bot branch unless --keep.

Agents get the bot's credential only. For Claude Code: run 'agent-gate env' and,
in that shell, 'claude' then '/web-setup'.
  agent-gate env      Print the export line that selects the bot's gh login.

  agent-gate install [DIR]
        Run from a clone of agent-gate: copy this script to DIR (default ~/.local/bin)
        and remember the clone for 'update'.
  agent-gate update
        Fast-forward the remembered clone from its origin and reinstall.
  agent-gate completion
        Print bash tab completion (install also writes it where bash-completion
        finds it). Manual use: eval "$(agent-gate completion)" in ~/.bashrc.
EOF
}

load_conf() {
  [[ -f $CONF ]] || die "no config; run 'agent-gate setup' first"
  # shellcheck source=/dev/null
  . "$CONF"
  : "${AG_OWNER:?}" "${AG_BOT:?}" "${AG_ALIAS:?}" "${AG_KEY:?}" "${AG_GH_DIR:?}"
}
gh_owner() { env -u GH_CONFIG_DIR gh "$@"; }
gh_bot()   { GH_CONFIG_DIR="$AG_GH_DIR" gh "$@"; }
# q CMD...: stdout of CMD on success, '?' on failure. gh writes its error JSON to stdout,
# so '|| echo' after a substitution would append to it rather than replace it.
q() { local out; out=$("$@" 2>/dev/null) || { echo "?"; return 0; }; printf '%s\n' "$out"; }
login_of() { q "$1" api user --jq .login; }
ssh_greets() { { ssh -T -o BatchMode=yes "$AG_ALIAS" 2>&1 || true; } | sed -n 's/^Hi \([^!]*\)!.*/\1/p' | head -1; }
# Repo name: from origin's URL when set (the local directory may be named differently).
repo_name() {
  local u; u=$(git config --get remote.origin.url || true)
  if [[ -n $u ]]; then basename -s .git "$u"; else basename "$(git rev-parse --show-toplevel)"; fi
}

# ---------------------------------------------------------------- setup
cmd_setup() {
  need git gh ssh ssh-keygen
  local owner="" bot="" alias="" key=""
  while (($#)); do case $1 in
    --owner) owner=$2; shift 2;; --bot) bot=$2; shift 2;;
    --alias) alias=$2; shift 2;; --key) key=$2; shift 2;;
    *) die "setup: unknown argument $1";; esac; done
  [[ -n $owner && -n $bot ]] || die "setup needs --owner and --bot"
  [[ $owner != "$bot" ]] || die "owner and bot must be different accounts"
  alias=${alias:-github-$bot}; key=${key:-$HOME/.ssh/id_$bot}
  local ghdir="${XDG_CONFIG_HOME:-$HOME/.config}/gh-$bot"

  echo "1/5 SSH key: $key"
  if [[ -f $key ]]; then say "exists, reusing"
  else ssh-keygen -t ed25519 -f "$key" -C "$bot agent-gate"; fi

  echo "2/5 SSH host alias: $alias"
  local sshc="$HOME/.ssh/config"
  if [[ -f $sshc ]] && grep -Eq "^[[:space:]]*Host[[:space:]]+(.*[[:space:]])?$alias([[:space:]]|\$)" "$sshc"; then
    say "Host $alias already in $sshc; leaving it. It MUST contain 'IdentitiesOnly yes'."
  else
    install -d -m 700 "$HOME/.ssh"
    local had=0
    if [[ -f $sshc ]]; then cp -p "$sshc" "$sshc.agent-gate.bak"; had=1; fi
    # Prepend: first match wins for most options. IdentityFile still accumulates, so a
    # 'Host *' IdentityFile needs '!<alias>' added there; 'agent-gate check' reports it.
    { cat <<EOF
# agent-gate: bot identity. IdentitiesOnly stops ssh-agent keys (yours) being offered first.
Host $alias
    User git
    HostName github.com
    IdentityFile $key
    IdentitiesOnly yes
    ForwardX11 no

EOF
      if ((had)); then cat "$sshc.agent-gate.bak"; fi
    } >"$sshc.agent-gate.new" && mv "$sshc.agent-gate.new" "$sshc"
    chmod 600 "$sshc"; say "added at the top (backup: $sshc.agent-gate.bak if a config existed)"
  fi

  echo "3/5 gh login for the BOT ($bot) in $ghdir"
  say "Sign in as $bot (use a private browser window if your browser is signed in as $owner)."
  say "--insecure-storage keeps the token in $ghdir: the system keyring is shared between"
  say "gh config dirs and would let one identity answer for the other."
  GH_CONFIG_DIR="$ghdir" gh auth login -h github.com -p ssh --skip-ssh-key \
      -s workflow,admin:public_key --insecure-storage
  local got; got=$(GH_CONFIG_DIR="$ghdir" gh api user --jq .login)
  [[ $got == "$bot" ]] || die "bot login returned '$got', expected '$bot'. Log out of that dir and retry."

  echo "4/5 Upload the public key to $bot"
  local fp; fp=$(ssh-keygen -lf "$key.pub" | awk '{print $2}')
  if GH_CONFIG_DIR="$ghdir" gh ssh-key list 2>/dev/null | grep -q "$(cut -d' ' -f2 "$key.pub")"; then
    say "already registered ($fp)"
  else
    GH_CONFIG_DIR="$ghdir" gh ssh-key add "$key.pub" --title "agent-gate $(hostname)"
  fi

  echo "5/5 Save config"
  install -d -m 700 "$CONF_DIR"
  cat >"$CONF" <<EOF
AG_OWNER=$owner
AG_BOT=$bot
AG_ALIAS=$alias
AG_KEY=$key
AG_GH_DIR=$ghdir
# AG_TEST_CMD='make test'      # optional: run by 'land' on the merge result before committing
EOF
  say "$CONF"
  echo
  load_conf; FAILS=0; check_identities
  echo
  say "Next: inside your project, 'agent-gate repo'. Optional shell alias:"
  say "  alias ghbot='GH_CONFIG_DIR=$ghdir gh'"
}

# ---------------------------------------------------------------- repo
cmd_repo() {
  need git gh; load_conf
  local public=0 name=""
  while (($#)); do case $1 in --public) public=1; shift;; -*) die "repo: unknown option $1";;
    *) name=$1; shift;; esac; done
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"
  git rev-parse --verify -q main >/dev/null || die "no local 'main' branch"
  name=${name:-$(repo_name)}
  local own="$AG_OWNER/$name" bot="$AG_BOT/$name"
  local url_o="git@github.com:$own.git" url_b="git@$AG_ALIAS:$bot.git"
  local vis=--private; ((public)) && vis=--public

  if gh_owner repo view "$own" >/dev/null 2>&1; then say "$own exists"
  else gh_owner repo create "$own" "$vis" >/dev/null; ok "created $own (${vis#--})"; fi
  set_remote origin "$url_o"
  git push origin main          # a fork needs a non-empty parent

  if gh_bot repo view "$bot" >/dev/null 2>&1; then say "$bot exists"
  elif ((public)); then gh_bot repo fork "$own" --clone=false >/dev/null; ok "forked $own as $bot"
  else gh_bot repo create "$bot" --private >/dev/null; ok "created $bot (private)"; fi
  set_remote bot "$url_b"
  ((public)) || git push bot main
  echo; FAILS=0; check_repo
}
set_remote() {
  local cur; cur=$(git config --get "remote.$1.url" || true)
  if [[ -z $cur ]]; then git remote add "$1" "$2"; ok "remote $1 -> $2"
  elif [[ $cur == "$2" ]]; then say "remote $1 already $2"
  else die "remote '$1' is $cur, expected $2; fix it by hand"; fi
}

# ---------------------------------------------------------------- check
check_identities() {
  local o b s
  o=$(login_of gh_owner); b=$(login_of gh_bot); s=$(ssh_greets)
  [[ $o == "$AG_OWNER" ]] && ok "gh (default) is $o" || bad "gh (default) is '${o:-none}', expected $AG_OWNER"
  [[ $b == "$AG_BOT"   ]] && ok "gh ($AG_GH_DIR) is $b" || bad "gh ($AG_GH_DIR) is '${b:-none}', expected $AG_BOT"
  if [[ $s == "$AG_BOT" ]]; then ok "ssh $AG_ALIAS authenticates as $s"
  elif [[ $s == "$AG_OWNER" ]]; then bad "ssh $AG_ALIAS authenticates as $s, YOUR account: an ssh-agent key was used instead of $AG_KEY"
  else bad "ssh $AG_ALIAS authenticates as '${s:-nothing}', expected $AG_BOT"; fi
  # Effective config, not the file: IdentityFile accumulates across every matching Host
  # block, so a 'Host *' IdentityFile is offered to the alias too, IdentitiesOnly or not.
  local eff only files extra="" f
  eff=$(ssh -G "$AG_ALIAS" 2>/dev/null || true)
  only=$(awk '$1=="identitiesonly"{print $2}' <<<"$eff")
  [[ $only == yes ]] && ok "$AG_ALIAS: IdentitiesOnly yes" \
    || bad "$AG_ALIAS: IdentitiesOnly is '${only:-unset}': ssh-agent keys may be offered first"
  files=$(awk '$1=="identityfile"{print $2}' <<<"$eff")
  while IFS= read -r f; do
    [[ -z $f ]] && continue
    f=${f/#\~/$HOME}
    [[ $f == "$AG_KEY" ]] || extra="$extra $f"
  done <<<"$files"
  [[ -z $extra ]] && ok "$AG_ALIAS offers only $AG_KEY" \
    || bad "$AG_ALIAS also offers:$extra (from another matching Host block, e.g. 'Host *'; exclude the alias there: 'Host * !$AG_ALIAS')"
}
check_repo() {
  local name own bot
  name=$(repo_name); own="$AG_OWNER/$name"; bot="$AG_BOT/$name"
  [[ $(git config --get remote.origin.url) == "git@github.com:$own.git" ]] \
    && ok "origin -> $own" || bad "origin is not git@github.com:$own.git"
  [[ $(git config --get remote.bot.url) == "git@$AG_ALIAS:$bot.git" ]] \
    && ok "bot -> $bot via $AG_ALIAS" \
    || bad "remote 'bot' is '$(git config --get remote.bot.url || echo unset)', expected git@$AG_ALIAS:$bot.git"
  local vis collab parent
  vis=$(q gh_owner api "repos/$own" --jq .private)
  collab=$(q gh_owner api "repos/$own/collaborators" \
      --jq "[.[].login | select(. != \"$AG_OWNER\")] | join(\" \")")
  [[ -z $collab ]] && ok "$own has no collaborators besides $AG_OWNER" \
    || bad "$own collaborators: '$collab' (MUST be none)"
  parent=$(q gh_bot api "repos/$bot" --jq '.parent.full_name // ""')
  if [[ $parent == "?" ]]; then
    bad "cannot read $bot as $AG_BOT (not created yet? run 'agent-gate repo', with --public for the fork route)"
    parent=""; local nobot=1
  fi
  case $vis in
    true)  # private route: independent bot repo, invisible to the bot
      ok "$own is private (two-repo route)"
      [[ -n ${nobot:-} ]] || { [[ -z $parent ]] && ok "$bot is not a fork"; } || bad "$bot is a fork of '$parent' (private route needs an independent repo)"
      if gh_bot api "repos/$own" >/dev/null 2>&1; then bad "$AG_BOT can read $own: the gate is open"
      else ok "$AG_BOT cannot see $own"; fi;;
    false) # public route: bot fork, changes arrive as pull requests
      ok "$own is public (fork route)"
      [[ -n ${nobot:-} ]] || { [[ $parent == "$own" ]] && ok "$bot is a fork of $own"; } \
        || bad "$bot is not a fork of $own (parent: '${parent:-none}')";;
    *) bad "cannot read $own as $AG_OWNER";;
  esac
  # Invariant 6: the bot's main mirrors the owner's, so agent branches start from current code.
  local mo mb
  mo=$(q git ls-remote origin refs/heads/main); mo=${mo%%[[:space:]]*}
  mb=$(q git ls-remote bot refs/heads/main);    mb=${mb%%[[:space:]]*}
  if [[ $mo == "?" || $mb == "?" || -z $mo || -z $mb ]]; then
    bad "cannot compare main on origin (${mo:-none}) and bot (${mb:-none})"
  elif [[ $mo == "$mb" ]]; then ok "bot main mirrors origin main (${mo:0:7})"
  else bad "bot main (${mb:0:7}) differs from origin main (${mo:0:7}): run 'git push bot main'"; fi
}
cmd_check() {
  need git gh ssh; load_conf; FAILS=0
  echo "identities"; check_identities
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then echo "repo"; check_repo; fi
  ((FAILS==0)) && echo "gate: closed" || { echo "gate: $FAILS problem(s)"; exit 1; }
}

# ---------------------------------------------------------------- review / land
# Owner/repo a remote points at, for messages: git@host:o/r.git -> o/r
remote_slug() { local u; u=$(git config --get "remote.$1.url" || true); u=${u%.git}; u=${u##*:}; echo "${u:-unset}"; }
fetch_branch() {
  git config --get remote.bot.url >/dev/null || die "no remote 'bot' in this repository ($(repo_name)); see 'agent-gate repo'"
  git fetch -q bot
  git rev-parse --verify -q "bot/$1" >/dev/null \
    || die "no branch '$1' on remote bot ($(remote_slug bot)); wrong repository?"
}
cmd_review() {
  local br="" mode=stat; local -a paths=()
  while (($#)); do case $1 in
    -p|--patch) mode=patch; shift;; --by-commit) mode=commits; shift;;
    --) shift; paths=("$@"); break;;
    -*) die "review: unknown option $1";;
    *) [[ -z $br ]] || die "review: one branch at a time"; br=$1; shift;; esac; done
  [[ -n $br ]] || die "usage: agent-gate review BRANCH [-p | --by-commit] [-- PATH...]"
  load_conf; fetch_branch "$br"
  local range="main...bot/$br"
  # ${paths[@]+...}: bash 3.2 treats an empty array as unset under 'set -u'.
  case $mode in
    stat)
      echo "commits (main..bot/$br):"; git log --oneline "main..bot/$br" -- ${paths[@]+"${paths[@]}"}
      echo; git diff --stat "$range" -- ${paths[@]+"${paths[@]}"}
      echo; say "full diff: agent-gate review $br -p   (per commit: --by-commit)";;
    patch)   git diff --stat --patch "$range" -- ${paths[@]+"${paths[@]}"};;
    commits) git log --reverse --stat --patch "main..bot/$br" -- ${paths[@]+"${paths[@]}"};;
  esac
}
cmd_land() {
  local br="" msg="" keep=0
  while (($#)); do case $1 in
    -m) msg=$2; shift 2;; --keep) keep=1; shift;;
    -*) die "land: unknown option $1";; *) br=$1; shift;; esac; done
  [[ -n $br ]] || die "usage: agent-gate land BRANCH [-m MSG] [--keep]"
  load_conf
  [[ $(git symbolic-ref --short HEAD) == main ]] || die "check out main first"
  [[ -z $(git status --porcelain --untracked-files=no) ]] || die "working tree not clean"
  git fetch -q origin
  if [[ $(git rev-parse main) != $(git rev-parse origin/main) ]]; then
    local ahead behind hint
    ahead=$(git rev-list --count origin/main..main); behind=$(git rev-list --count main..origin/main)
    if ((behind == 0)); then hint="unpushed local commits: 'git log origin/main..main', then 'git push origin main && git push bot main'"
    elif ((ahead == 0)); then hint="'git pull --ff-only origin main'"
    else hint="diverged: inspect 'git log --oneline --graph main origin/main' and reconcile by hand"; fi
    die "main is $ahead ahead, $behind behind origin/main; $hint"
  fi
  fetch_branch "$br"
  git log --oneline "main..bot/$br"
  ask "merge these into main?" || die "aborted"
  git merge --no-ff --no-commit "bot/$br" || die "conflict: resolve, or 'git merge --abort'"
  if [[ -n ${AG_TEST_CMD:-} ]]; then
    say "running: $AG_TEST_CMD"
    if ! bash -c "$AG_TEST_CMD"; then git merge --abort; die "tests failed; merge aborted"; fi
  fi
  git commit -q -m "${msg:-Merge $br}"
  git push origin main && git push bot main
  ((keep)) || git push -q bot --delete "$br"
  ok "landed $br"
}

# ---------------------------------------------------------------- install / update
SRC_FILE="$CONF_DIR/source"      # path of the clone the installed copy came from
cmd_install() {
  local dest=${1:-$HOME/.local/bin} self src
  self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
  src=$(git -C "$(dirname "$self")" rev-parse --show-toplevel 2>/dev/null) \
    || die "install: run it from a clone of agent-gate (./agent-gate install)"
  [[ $self == "$src/agent-gate" ]] || die "install: run the clone's own copy: $src/agent-gate install"
  install -d "$dest" && install -m 755 "$self" "$dest/agent-gate"
  install -d -m 700 "$CONF_DIR" && printf '%s\n' "$src" >"$SRC_FILE"
  ok "installed $dest/agent-gate ($(git -C "$src" describe --always --dirty))"
  ok "update source: $src"
  install -d "$COMP_DIR" && "$self" completion >"$COMP_DIR/agent-gate" \
    && ok "bash completion: $COMP_DIR/agent-gate (loaded by bash-completion in new shells)"
  case ":$PATH:" in *":$dest:"*) ;; *) say "note: $dest is not on PATH";; esac
}
cmd_update() {
  need git
  [[ -f $SRC_FILE ]] || die "update: no recorded clone; run './agent-gate install' from one first"
  local src; src=$(<"$SRC_FILE")
  git -C "$src" rev-parse --git-dir >/dev/null 2>&1 || die "update: $src is no longer a git clone"
  [[ $(git -C "$src" symbolic-ref --short HEAD) == main ]] || die "update: $src is not on main"
  [[ -z $(git -C "$src" status --porcelain --untracked-files=no) ]] || die "update: $src has local changes"
  local before; before=$(git -C "$src" rev-parse --short HEAD)
  git -C "$src" pull -q --ff-only origin main || die "update: cannot fast-forward $src; resolve it by hand"
  if [[ $(git -C "$src" rev-parse --short HEAD) == "$before" ]]; then say "already current ($before)"
  else git -C "$src" log --oneline "$before..HEAD"; fi
  "$src/agent-gate" install "$(dirname "$(command -v agent-gate || echo "$HOME/.local/bin/agent-gate")")"
}

# ---------------------------------------------------------------- completion
COMP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
cmd_completion() {
  cat <<'EOF'
# bash completion for agent-gate. Branch names come from the local refs/remotes/bot/*
# (current as of the last fetch; 'agent-gate review' fetches). No network on <Tab>.
_agent_gate() {
  local cur=${COMP_WORDS[COMP_CWORD]} cmd=${COMP_WORDS[1]:-}
  if ((COMP_CWORD == 1)); then
    COMPREPLY=($(compgen -W "setup repo check review land env install update completion help --version" -- "$cur"))
    return
  fi
  case $cmd in
    review|land)
      case $cur in
        -*) if [[ $cmd == review ]]; then COMPREPLY=($(compgen -W "-p --by-commit --" -- "$cur"))
            else COMPREPLY=($(compgen -W "-m --keep" -- "$cur")); fi;;
        *)  local w; for w in "${COMP_WORDS[@]:2:COMP_CWORD-2}"; do
              [[ $w == -- ]] && { COMPREPLY=($(compgen -f -- "$cur")); return; }
            done
            COMPREPLY=($(compgen -W "$(git for-each-ref --format='%(refname:strip=3)' \
                refs/remotes/bot/ 2>/dev/null | grep -vxE 'HEAD|main')" -- "$cur"));;
      esac;;
    setup)   COMPREPLY=($(compgen -W "--owner --bot --alias --key" -- "$cur"));;
    repo)    COMPREPLY=($(compgen -W "--public" -- "$cur"));;
    install) COMPREPLY=($(compgen -d -- "$cur"));;
  esac
}
complete -F _agent_gate agent-gate
EOF
}

cmd_env() { load_conf; echo "export GH_CONFIG_DIR=$AG_GH_DIR"; }

case ${1:-} in
  setup)  shift; cmd_setup "$@";;
  repo)   shift; cmd_repo "$@";;
  check)  shift; cmd_check "$@";;
  review) shift; cmd_review "$@";;
  land)   shift; cmd_land "$@";;
  env)    shift; cmd_env "$@";;
  install) shift; cmd_install "$@";;
  update)  shift; cmd_update "$@";;
  completion) shift; cmd_completion "$@";;
  -V|--version) echo "$VERSION";;
  ""|-h|--help|help) usage;;
  *) die "unknown command '$1' (see --help)";;
esac
